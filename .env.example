# Database (postgres + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=otomotif_ai
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:change-me-in-production@localhost:5432/otomotif_ai

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Application
DEBUG=False
ENVIRONMENT=production

# Auth (REQUIRED: change in production — never commit real secrets)
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=1440

# API
API_PORT=8000

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Shopee Affiliate (fill in before production)
SHOPEE_APP_ID=
SHOPEE_APP_KEY=
SHOPEE_APP_SECRET=

# OpenAI / LLM (diagnosis)
OPENROUTER_API_KEY=

# 3D Engine Adapter (fallback | replicate | huggingface | external)
THREE_D_ENGINE=fallback
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL_ID=
EXTERNAL_3D_WORKER_URL=
