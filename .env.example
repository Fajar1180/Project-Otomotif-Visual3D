# Database (postgres + pgvector)
POSTGRES_USER=postgres
# REQUIRED — compose refuses to start if empty. Generate: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=otomotif_ai
# Host-side only (bound to 127.0.0.1); api/worker talk to `postgres:5432` internally
POSTGRES_PORT=5432

# DATABASE_URL is NOT read by docker-compose — it is derived from the four
# POSTGRES_* vars above with host `postgres`. Set it only when running the
# backend outside Docker:
# DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/otomotif_ai

# Redis / Celery
# Compose wires REDIS_URL to redis://redis:6379/0 internally. This value is
# only for running the backend outside Docker:
# REDIS_URL=redis://localhost:6379/0

# Application
DEBUG=False
ENVIRONMENT=production

# Auth — REQUIRED. Compose refuses to start if empty; config.py also rejects
# empty/default values when ENVIRONMENT=production.
# Generate: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# API
API_PORT=8000

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Shopee Affiliate (fill in before production)
SHOPEE_APP_ID=
SHOPEE_APP_KEY=
SHOPEE_APP_SECRET=

# OpenAI / LLM (diagnosis)
OPENROUTER_API_KEY=

# 3D Engine Adapter (fallback | replicate | huggingface | external)
THREE_D_ENGINE=fallback
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL_ID=
EXTERNAL_3D_WORKER_URL=
