# Copy to .env and adjust for local deployment

# === App settings ===
DEBUG=True
ENVIRONMENT=development

# === Auth ===
JWT_SECRET=dev-secret-change-me
JWT_EXPIRE_MINUTES=1440

# === Database ===
DATABASE_URL=sqlite:///:memory:

# === Redis / Celery ===
REDIS_URL=redis://localhost:6379/0
CELERY_ALWAYS_EAGER=true

# === Shopee ===
SHOPEE_APP_ID=
SHOPEE_APP_KEY=
SHOPEE_APP_SECRET=

# === 3D Engine Adapter ===
THREE_D_ENGINE=fallback
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VERSION=
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL_ID=
EXTERNAL_3D_WORKER_URL=
THREE_D_OUTPUT_DIR=
